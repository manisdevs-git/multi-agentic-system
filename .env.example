# Copy to .env. Never commit .env.
DEEPINFRA_API_KEY=
# Default for Facts, Pattern, Compliance, and the reviewer.
# DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Optional: a different model for the reviewer only.
# DEEPINFRA_REVIEW_MODEL=zai-org/GLM-5.3-Flash

# Default To on the preview. Gmail sends from the MCP workspace account.
MAIL_TO=

# Local manismcpserver (other Cursor instance): http://127.0.0.1:8080/mcp
# Hosted Cloud Run is often 503 when the service is scaled to zero.
MCP_SERVER_URL=http://127.0.0.1:8080/mcp
MCP_AUTH_TOKEN=
MCP_GMAIL_TOOL=send_email
MCP_DOCS_TOOL=reflect_content
MCP_GMAIL_CC=
